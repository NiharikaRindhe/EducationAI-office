# ─── Supabase (self-hosted, local dev via `supabase start`) ───────
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-anon-key-from-supabase-status
SUPABASE_SERVICE_KEY=replace-with-service-role-key-from-supabase-status
SUPABASE_JWT_SECRET=replace-with-jwt-secret-from-supabase-status

# ─── Ollama (single local daemon — model name picks local vs cloud) ─
# Cloud models need the daemon itself signed in (`ollama signin`) or its
# OLLAMA_API_KEY env var set — nothing is passed per-request from this app.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=gpt-oss:20b-cloud
OLLAMA_EMBED_MODEL=mxbai-embed-large

# ─── Redis (shared AI slots across API replicas) ───────────────────
# Local: docker run -d --name eduai-redis -p 6379:6379 redis:7.4-alpine
# Unset = in-process fallback only (one API, not multi-school fair).
REDIS_URL=redis://127.0.0.1:6379
AI_CHAT_MAX_GLOBAL=30
AI_CHAT_MAX_PER_SCHOOL=12
AI_CHAT_MAX_PER_STUDENT=1
AI_VISION_MAX_GLOBAL=8
AI_VISION_MAX_PER_SCHOOL=4
AI_VISION_MAX_PER_STUDENT=1
AI_SLOT_TTL_SEC=180

# ─── App ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# ─── Transactional email (SMTP) ─────────────────────────────────────
# Unset SMTP_HOST disables sending entirely — every credential is also
# shown once in the admin UI, so email is an enhancement, never a
# dependency. Local dev: Supabase's Mailpit accepts SMTP on 54325
# (view sent mail at http://127.0.0.1:54324), no auth needed.
SMTP_HOST=smtppro.zoho.in
# Port 587 (STARTTLS), not 465 (SSL) — some networks/firewalls block
# 465 outbound while 587 gets through; both work against Zoho.
SMTP_PORT=587
SMTP_USER=your-account@yourdomain.com
SMTP_PASS=your-smtp-or-app-specific-password
SMTP_FROM=EduAI <your-account@yourdomain.com>
# Optional — where a recipient's "Reply" lands. Falls back to SMTP_FROM if unset.
SMTP_REPLY_TO=your-account@yourdomain.com
